# Copy to terraform.tfvars (gitignored) and fill in.
project_name = "squad"
region       = "eu-north-1"

# The same Google OAuth client as in spry works; add google_redirect_uri (an output) to it.
google_client_id = ""
# google_client_secret: export TF_VAR_google_client_secret=... in the terminal, never write it here.

mono_jar_url      = "https://send.monobank.ua/jar/XXXXXXXX"
premium_price_uah = 50

# Own domain: step 1 set domain_name, step 2 (after the certificate is issued) attach_domain = true.
# domain_name   = "squad.pp.ua"
# attach_domain = false
